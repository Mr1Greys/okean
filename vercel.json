{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "PORT=4173 BASE_PATH=/ pnpm --filter @workspace/okeana run build",
  "outputDirectory": "artifacts/okeana/dist/public",
  "framework": null,
  "env": {
    "PORT": "4173",
    "BASE_PATH": "/"
  },
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
